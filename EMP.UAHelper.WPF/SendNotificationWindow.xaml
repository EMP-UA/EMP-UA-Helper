<!-- Author: EMP_UA | https://github.com/EMP-UA/EMP-UA-Helper -->
<!-- Donate: https://ko-fi.com/emp_ua -->
<!-- UA: Вікно надсилання сповіщення — завжди показує приклад перед відправкою,
     окремо для Telegram і Discord, з мініатюрою й м'яким попередженням про
     нерозпізнане посилання.
     EN: Send-notification window — always shows a preview before sending,
     separately for Telegram and Discord, with a thumbnail and a soft warning
     for unrecognized links. -->
<Window x:Class="EMP.UAHelper.WPF.SendNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="960" Width="580"
        MinHeight="700" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#0D0A14">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E0F0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,3"/>
        </Style>

        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B8A8D0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="WarningHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0A030"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1425"/>
            <Setter Property="Foreground" Value="#E8E0F0"/>
            <Setter Property="BorderBrush" Value="#3D2B5E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="SelectionBrush" Value="#8A46C1"/>
        </Style>

        <Style x:Key="EmpButton" TargetType="Button">
            <Setter Property="Background" Value="#8A46C1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C989F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LangButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1425"/>
            <Setter Property="Foreground" Value="#C989F3"/>
            <Setter Property="BorderBrush" Value="#8A46C1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D2B5E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AutoCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8E0F0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style x:Key="PreviewBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1425"/>
            <Setter Property="Foreground" Value="#B8A8D0"/>
            <Setter Property="BorderBrush" Value="#3D2B5E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="70"/>
            <Setter Property="MaxHeight" Value="130"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="PlatformPreviewLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C989F3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
        </Style>

        <Style x:Key="PickerToggleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C989F3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0,8,0,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#8A46C1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkListBox" TargetType="ListBox">
            <Setter Property="Background" Value="#1A1425"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <Style x:Key="DarkListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3D2B5E"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#8A46C1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- UA: ComboItemStyle, ComboField і DarkCalendar тепер у спільному
                 App.xaml → Styles/DarkComboBox.xaml, Styles/DarkCalendar.xaml
                 (не дублюємо тут)
             EN: ComboItemStyle, ComboField and DarkCalendar now live in the
                 shared App.xaml → Styles/DarkComboBox.xaml,
                 Styles/DarkCalendar.xaml (not duplicated here) -->

        <!-- UA: Компактна квадратна кнопка-іконка — для пікерів дати/часу
                 (📅/🕐) і кнопок "зараз" (⏱) біля полів дати/часу
             EN: Compact square icon button — for the date/time pickers
                 (📅/🕐) and the "now" buttons (⏱) next to date/time fields -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1425"/>
            <Setter Property="Foreground" Value="#C989F3"/>
            <Setter Property="BorderBrush" Value="#3D2B5E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D2B5E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,24">

            <!-- UA: Заголовок і перемикач мови
                 EN: Header and language switcher -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtHeader"
                           Grid.Column="0"
                           Foreground="#C989F3" FontSize="20" FontWeight="Bold"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button x:Name="BtnUA" Content="🇺🇦 UA"
                            Style="{StaticResource LangButton}"
                            Margin="0,0,4,0"
                            Click="BtnUA_Click"/>
                    <Button x:Name="BtnEN" Content="🇬🇧 EN"
                            Style="{StaticResource LangButton}"
                            Click="BtnEN_Click"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="TxtDescription"
                       Foreground="#B8A8D0" FontSize="13" Margin="0,6,0,0"
                       TextWrapping="Wrap"/>

            <!-- UA: Перемикач повністю ручного режиму — вимикає будь-яку
                     підстановку шаблону, відправляється рівно те, що введено
                     в полях нижче, окремо для кожної платформи
                 EN: Fully manual mode toggle — disables all template
                     substitution, sends exactly what was typed in the fields
                     below, separately per platform -->
            <CheckBox x:Name="ChkRawMode" Style="{StaticResource AutoCheckBox}"
                      Checked="ChkRawMode_Changed" Unchecked="ChkRawMode_Changed"/>
            <TextBlock x:Name="TxtRawModeHint" Style="{StaticResource FieldHint}"/>

            <!-- UA: Вибір Discord-каналу. Увесь блок існує лише якщо в
                     налаштуваннях заведено більше одного каналу — при одному
                     каналі вікно виглядає точно як раніше, тобто наявним
                     користувачам нічого не додається "просто так".
                     Типово надсилаємо в основний канал: галочка потрібна саме
                     щоб змінити канал була свідома дія, а не випадковий клік
                     по списку, який відправить анонс не туди. Список
                     з'являється тільки після зняття цієї галочки.
                     Блок спільний для обох режимів (шаблонного і ручного) —
                     стоїть до їх розділення, бо канал це властивість
                     відправки, а не режиму
                 EN: Discord channel picker. The whole block only exists when
                     more than one channel is configured — with a single channel
                     the window looks exactly as before, i.e. nothing is added
                     "just because" for existing users.
                     The primary channel is the default: the checkbox exists so
                     that changing the channel is a deliberate act, not a stray
                     click in a list that sends the announcement to the wrong
                     place. The list appears only once the box is ticked.
                     The block is shared by both modes (template and manual) —
                     it sits before they split, because the channel is a
                     property of the send, not of the mode -->
            <StackPanel x:Name="PanelChannelPicker" Visibility="Collapsed" Margin="0,8,0,0">
                <CheckBox x:Name="ChkOverrideChannel" Style="{StaticResource AutoCheckBox}"
                          Checked="ChkOverrideChannel_Changed" Unchecked="ChkOverrideChannel_Changed"/>
                <!-- UA: Прив'язаний лише до назв (List of string) з коду-behind —
                         дивись коментар у BuildChannelList() у .xaml.cs.
                     EN: Bound only to names (List of string) from code-behind —
                         see the comment in BuildChannelList() in the .xaml.cs. -->
                <ComboBox x:Name="ChannelCombo" Visibility="Collapsed" Margin="0,6,0,0"
                          Style="{StaticResource ComboField}"
                          ItemContainerStyle="{StaticResource ComboItemStyle}"/>
                <TextBlock x:Name="TxtChannelHint" Style="{StaticResource FieldHint}"/>
            </StackPanel>

            <Rectangle Height="1" Fill="#3D2B5E" Margin="0,12,0,0"/>

            <!-- UA: Режим за шаблоном — приклад, автопідбір, поля заголовка/типу/URL/дати
                 EN: Template mode — preview, auto-pick, title/type/url/date fields -->
            <StackPanel x:Name="PanelTemplateMode">

            <!-- UA: Чекбокс автопідбору — видимий лише якщо YouTube увімкнено
                 EN: Auto-pick checkbox — visible only if YouTube is enabled -->
            <CheckBox x:Name="ChkAutoLatest" Style="{StaticResource AutoCheckBox}"
                      Visibility="Collapsed"
                      Checked="ChkAutoLatest_Changed" Unchecked="ChkAutoLatest_Changed"/>

            <!-- UA: Мініатюра — з'являється лише коли вдалось розпізнати джерело
                 EN: Thumbnail — appears only when a source is successfully resolved -->
            <Border x:Name="PanelThumbnail" Visibility="Collapsed" Margin="0,12,0,0"
                    Background="#1A1425" BorderBrush="#3D2B5E" BorderThickness="1"
                    HorizontalAlignment="Left">
                <StackPanel>
                    <Image x:Name="PreviewThumbnail" Width="280" Height="158" Stretch="UniformToFill"/>
                    <TextBlock x:Name="TxtThumbnailNote" Style="{StaticResource FieldHint}"
                               Visibility="Collapsed" MaxWidth="280" Margin="8,4,8,6"/>
                </StackPanel>
            </Border>

            <!-- UA: Приклад для Telegram — окремий блок
                 EN: Telegram preview — separate block -->
            <StackPanel x:Name="PanelPreviewTelegram" Visibility="Collapsed">
                <TextBlock x:Name="TxtPreviewTelegramLabel" Style="{StaticResource PlatformPreviewLabel}"/>
                <TextBox x:Name="PreviewTelegramBox" Style="{StaticResource PreviewBox}"/>
            </StackPanel>

            <!-- UA: Приклад для Discord — окремий блок
                 EN: Discord preview — separate block -->
            <StackPanel x:Name="PanelPreviewDiscord" Visibility="Collapsed">
                <TextBlock x:Name="TxtPreviewDiscordLabel" Style="{StaticResource PlatformPreviewLabel}"/>
                <TextBox x:Name="PreviewDiscordBox" Style="{StaticResource PreviewBox}"/>
            </StackPanel>

            <!-- UA: Показується лише якщо жодна платформа сповіщень не увімкнена
                 EN: Shown only if no notification platform is enabled -->
            <TextBlock x:Name="TxtPreviewEmpty" Style="{StaticResource FieldHint}" Visibility="Collapsed"/>

            <!-- UA: Банер статусу завантаження списку з YouTube. Свідомо ЗЗОВНІ
                     PanelPickerRow: той рядок ховається при увімкненому
                     автопідборі, і повідомлення про помилку разом з ним ставало
                     невидимим саме в найпоширенішому сценарії — вікно виглядало
                     просто порожнім, без жодного пояснення чому.
                     Кольори фону/рамки й іконка призначаються з code-behind
                     (нейтральні для "завантаження", жовті для "показано з кешу",
                     червоні для повного провалу) — щоб не плодити три майже
                     однакові розмітки під кожен стан.
                 EN: YouTube list loading status banner. Deliberately OUTSIDE
                     PanelPickerRow: that row is hidden while auto-pick is on, so
                     the error message used to become invisible in exactly the
                     most common scenario — the window just looked empty with no
                     explanation why.
                     Background/border colors and the icon are assigned from
                     code-behind (neutral for "loading", amber for "served from
                     cache", red for a total failure) — to avoid three nearly
                     identical markup blocks, one per state. -->
            <Border x:Name="PanelPickerStatus" Visibility="Collapsed"
                    BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtPickerStatusIcon" Grid.Column="0"
                               FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top"/>

                    <TextBlock x:Name="TxtPickerStatus" Grid.Column="1"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>

                    <!-- UA: Повтор запиту без перезапуску програми — при
                         тимчасовому збої мережі не треба закривати вікно.
                         Поруч — запасний шлях через API, який з'являється
                         тільки після виявленої помилки і питає підтвердження,
                         бо витрачає добову квоту (безкоштовний RSS її не чіпає)
                         EN: Retry without restarting the app — a transient
                         network glitch shouldn't require closing the window.
                         Next to it, the API fallback, which only appears after
                         a detected error and asks for confirmation, because it
                         spends the daily quota (the free RSS feed doesn't) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button x:Name="BtnRetryLoad" Content="↻"
                                Style="{StaticResource IconButton}"
                                Visibility="Collapsed" Click="BtnRetryLoad_Click"/>
                        <Button x:Name="BtnApiFallback" Content="🔑"
                                Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                Visibility="Collapsed" Click="BtnApiFallback_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- UA: Рядок-перемикач списку кандидатів — з'являється лише коли
                     автопідбір знятий
                 EN: Candidate list toggle row — appears only when auto-pick is off -->
            <StackPanel x:Name="PanelPickerRow" Visibility="Collapsed">
                <Button x:Name="BtnTogglePicker" Style="{StaticResource PickerToggleButton}"
                        Click="BtnTogglePicker_Click"/>
                <TextBlock x:Name="TxtPickerHint" Style="{StaticResource FieldHint}"/>

                <Border x:Name="PanelPickerList" Visibility="Collapsed" Margin="0,4,0,0"
                        BorderBrush="#3D2B5E" BorderThickness="1">
                    <ListBox x:Name="CandidatesList" Style="{StaticResource DarkListBox}"
                             ItemContainerStyle="{StaticResource DarkListBoxItem}"
                             MaxHeight="240"
                             SelectionChanged="CandidatesList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="72" Height="40" Background="#0D0A14">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Foreground="#E8E0F0"
                                                   FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SubLabel}" Foreground="#B8A8D0" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>

            <Rectangle Height="1" Fill="#3D2B5E" Margin="0,16,0,0"/>

            <TextBlock x:Name="TxtTitleLabel" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TitleInput" Style="{StaticResource InputField}"
                     TextChanged="Field_TextChanged"/>

            <TextBlock x:Name="TxtTypeLabel" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="TypeCombo" Style="{StaticResource ComboField}"
                      SelectionChanged="TypeCombo_SelectionChanged">
                <ComboBoxItem x:Name="ItemLive" Tag="Live"/>
                <ComboBoxItem x:Name="ItemUpcoming" Tag="Upcoming"/>
                <ComboBoxItem x:Name="ItemVideo" Tag="Video"/>
                <ComboBoxItem x:Name="ItemShort" Tag="Short"/>
            </ComboBox>
            <TextBlock x:Name="TxtTypeHint" Style="{StaticResource FieldHint}"/>

            <TextBlock x:Name="TxtUrlLabel" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="UrlInput" Style="{StaticResource InputField}"
                     TextChanged="UrlInput_TextChanged"/>
            <TextBlock x:Name="TxtUrlHint" Style="{StaticResource FieldHint}"/>
            <TextBlock x:Name="TxtUrlWarning" Style="{StaticResource WarningHint}" Visibility="Collapsed"/>

            <!-- UA: Поля дати/часу тепер завжди видимі — підпис змінюється
                     залежно від типу (обов'язкові для Upcoming, довідкові
                     для решти)
                 EN: Date/time fields are now always visible — the label
                     changes depending on type (required for Upcoming,
                     informational for the rest) -->
            <TextBlock x:Name="TxtDateLabel" Style="{StaticResource FieldLabel}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DateInput" Grid.Column="0" Style="{StaticResource InputField}"
                         TextChanged="Field_TextChanged"/>
                <Button x:Name="BtnPickDate" Grid.Column="1" Content="📅"
                        Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="BtnPickDate_Click"/>
                <Button x:Name="BtnDateNow" Grid.Column="2" Content="⏱"
                        Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="BtnDateNow_Click"/>
            </Grid>

            <TextBlock x:Name="TxtTimeLabel" Style="{StaticResource FieldLabel}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TimeInput" Grid.Column="0" Style="{StaticResource InputField}"
                         TextChanged="Field_TextChanged"/>
                <Button x:Name="BtnPickTime" Grid.Column="1" Content="🕐"
                        Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="BtnPickTime_Click"/>
                <Button x:Name="BtnTimeNow" Grid.Column="2" Content="⏱"
                        Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="BtnTimeNow_Click"/>
            </Grid>

            </StackPanel>

            <!-- UA: Повністю ручний режим — жодного шаблону, окремі поля для
                     Telegram і Discord, бо теги/форматування платформозалежні
                 EN: Fully manual mode — no template at all, separate fields
                     for Telegram and Discord, since tags/formatting are
                     platform-specific -->
            <StackPanel x:Name="PanelRawMode" Visibility="Collapsed">

                <!-- UA: Опціональна дата/час трансляції (у зоні з "⚙️ Налаштування")
                         — спільна для обох платформ, лише генерує позначки
                         часу нижче. Нічого нікуди автоматично не підставляється
                         — це суперечило б суті ручного режиму
                     EN: Optional stream date/time (in the zone set under
                         "⚙️ Settings") — shared for both platforms, only
                         generates the timestamp snippets below. Nothing is
                         auto-inserted anywhere — that would defeat the point
                         of manual mode -->
                <TextBlock x:Name="TxtRawDateLabel" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RawDateInput" Grid.Column="0" Style="{StaticResource InputField}"
                             TextChanged="RawScheduled_TextChanged"/>
                    <Button x:Name="BtnPickDateRaw" Grid.Column="1" Content="📅"
                            Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="BtnPickDateRaw_Click"/>
                    <Button x:Name="BtnDateNowRaw" Grid.Column="2" Content="⏱"
                            Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="BtnDateNowRaw_Click"/>
                </Grid>

                <TextBlock x:Name="TxtRawTimeLabel" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RawTimeInput" Grid.Column="0" Style="{StaticResource InputField}"
                             TextChanged="RawScheduled_TextChanged"/>
                    <Button x:Name="BtnPickTimeRaw" Grid.Column="1" Content="🕐"
                            Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="BtnPickTimeRaw_Click"/>
                    <Button x:Name="BtnTimeNowRaw" Grid.Column="2" Content="⏱"
                            Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="BtnTimeNowRaw_Click"/>
                </Grid>
                <TextBlock x:Name="TxtRawScheduledHint" Style="{StaticResource FieldHint}"/>

                <StackPanel x:Name="PanelRawTelegram">
                    <TextBlock x:Name="TxtRawTelegramLabel" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="RawTelegramInput" Style="{StaticResource InputField}"
                             Height="140" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                    <TextBlock x:Name="TxtRawTelegramHint" Style="{StaticResource FieldHint}"/>

                    <!-- UA: Згенерована позначка часу для Telegram — з'являється
                             лише коли дата/час коректні. Читається, копіюється
                             (виділенням чи кнопкою) і вручну вставляється в
                             текст вище, де потрібно
                         EN: Generated Telegram timestamp — appears only once
                             the date/time are valid. Read-only, copyable (by
                             selection or the button) and manually pasted into
                             the text above wherever needed -->
                    <StackPanel x:Name="PanelRawTelegramSnippet" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock x:Name="TxtRawTelegramSnippetLabel" Style="{StaticResource PlatformPreviewLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RawTelegramSnippetBox" Grid.Column="0"
                                     Style="{StaticResource InputField}" IsReadOnly="True"/>
                            <Button x:Name="BtnCopyTelegramSnippet" Grid.Column="1"
                                    Content="📋" Style="{StaticResource LangButton}"
                                    Margin="6,0,0,0" Click="BtnCopyTelegramSnippet_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="PanelRawDiscord">
                    <TextBlock x:Name="TxtRawDiscordLabel" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="RawDiscordInput" Style="{StaticResource InputField}"
                             Height="140" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                    <TextBlock x:Name="TxtRawDiscordHint" Style="{StaticResource FieldHint}"/>

                    <!-- UA: Те саме для Discord — тег <t:...:F> (<t:...:R>),
                             який Discord сам рендерить у локальному часі читача
                         EN: Same for Discord — the <t:...:F> (<t:...:R>) tag,
                             which Discord renders in the reader's own local time -->
                    <StackPanel x:Name="PanelRawDiscordSnippet" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock x:Name="TxtRawDiscordSnippetLabel" Style="{StaticResource PlatformPreviewLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RawDiscordSnippetBox" Grid.Column="0"
                                     Style="{StaticResource InputField}" IsReadOnly="True"/>
                            <Button x:Name="BtnCopyDiscordSnippet" Grid.Column="1"
                                    Content="📋" Style="{StaticResource LangButton}"
                                    Margin="6,0,0,0" Click="BtnCopyDiscordSnippet_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- UA: Генератор тегу згадки — за тим самим принципом, що й
                             позначка часу вище: вводиш лише ID, отримуєш готовий
                             код, який копіюєш і вставляєш куди треба. Нічого
                             автоматично в текст не підставляється, бо це
                             суперечило б суті ручного режиму.
                             Тип згадки обирається списком, бо синтаксис у
                             Discord різний: роль <@&ID>, користувач <@ID>,
                             канал <#ID> — переплутати їх легко, а помилка
                             видима вже після надсилання
                         EN: Mention tag generator — same principle as the
                             timestamp above: you enter just the ID and get the
                             finished code to copy and paste wherever needed.
                             Nothing is auto-inserted into the text, as that
                             would defeat the point of manual mode.
                             The mention type is picked from a list because
                             Discord's syntax differs: role <@&ID>, user <@ID>,
                             channel <#ID> — easy to mix up, and the mistake is
                             only visible after sending -->
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock x:Name="TxtRawMentionLabel" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="MentionTypeCombo" Grid.Column="0" Width="150"
                                      Style="{StaticResource ComboField}"
                                      ItemContainerStyle="{StaticResource ComboItemStyle}"
                                      SelectionChanged="MentionType_SelectionChanged">
                                <ComboBoxItem x:Name="ItemMentionRole" Tag="role"/>
                                <ComboBoxItem x:Name="ItemMentionUser" Tag="user"/>
                                <ComboBoxItem x:Name="ItemMentionChannel" Tag="channel"/>
                            </ComboBox>
                            <TextBox x:Name="RawMentionIdInput" Grid.Column="1"
                                     Style="{StaticResource InputField}" Margin="6,0,0,0"
                                     TextChanged="MentionId_TextChanged"/>
                        </Grid>
                        <TextBlock x:Name="TxtRawMentionHint" Style="{StaticResource FieldHint}"/>

                        <StackPanel x:Name="PanelRawMentionSnippet" Visibility="Collapsed" Margin="0,6,0,0">
                            <TextBlock x:Name="TxtRawMentionSnippetLabel" Style="{StaticResource PlatformPreviewLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RawMentionSnippetBox" Grid.Column="0"
                                         Style="{StaticResource InputField}" IsReadOnly="True"/>
                                <Button x:Name="BtnCopyMentionSnippet" Grid.Column="1"
                                        Content="📋" Style="{StaticResource LangButton}"
                                        Margin="6,0,0,0" Click="BtnCopyMentionSnippet_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="TxtRawEmpty" Style="{StaticResource FieldHint}" Visibility="Collapsed"/>

            </StackPanel>

            <Button x:Name="BtnSend"
                    Style="{StaticResource EmpButton}"
                    Margin="0,24,0,0" HorizontalAlignment="Right"
                    Click="BtnSend_Click"/>

            <!-- UA: Спільні спливні пікери дати/часу — по одному на все вікно,
                     використовуються всіма 4 полями дати/часу (шаблонний і
                     ручний режими). Перед відкриттям код-behind перепризначає
                     PlacementTarget і "цільове" текстове поле, куди піде
                     результат вибору
                 EN: Shared floating date/time pickers — one of each for the
                     whole window, reused by all 4 date/time fields (template
                     and manual modes). Before opening, the code-behind
                     reassigns PlacementTarget and the "target" text field the
                     picked value goes into -->
            <Popup x:Name="DatePickerPopup" Placement="Bottom" AllowsTransparency="True"
                   StaysOpen="False" PopupAnimation="Slide">
                <Border Background="#1A1425" BorderBrush="#8A46C1" BorderThickness="1" Padding="4">
                    <Calendar x:Name="DatePickerCalendar" Style="{StaticResource DarkCalendar}"
                              SelectedDatesChanged="DatePickerCalendar_SelectedDatesChanged">
                        <!-- UA: Неявні (без x:Key) стилі для Button/TextBlock — застосовуються
                             лише в межах цього Calendar (шапка місяць/рік, стрілки навігації),
                             а не по всьому вікну. Значення кольору беруться зі спільного
                             DarkCalendar.xaml, щоб не дублювати хардкод. Причина, чому це не
                             задано просто в стилі DarkCalendar — Setter Property="Resources" у
                             Style неможливий (Resources — не DependencyProperty).
                             EN: Implicit (no x:Key) Button/TextBlock styles — apply only within
                             this Calendar (month/year header, navigation arrows), not window-wide.
                             Color values come from the shared DarkCalendar.xaml to avoid
                             duplicating the hardcoded hex. Reason this isn't set on the DarkCalendar
                             style itself — Setter Property="Resources" is impossible in a Style
                             (Resources isn't a DependencyProperty). -->
                        <Calendar.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource DarkCalendarNavButtonStyle}"/>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DarkCalendarNavTextStyle}"/>
                        </Calendar.Resources>
                    </Calendar>
                </Border>
            </Popup>

            <Popup x:Name="TimePickerPopup" Placement="Bottom" AllowsTransparency="True"
                   StaysOpen="False" PopupAnimation="Slide">
                <Border Background="#1A1425" BorderBrush="#8A46C1" BorderThickness="1" Padding="10">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="HourCombo" Style="{StaticResource ComboField}" Width="70"/>
                        <TextBlock Text=":" Foreground="#E8E0F0" FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="8,0"/>
                        <ComboBox x:Name="MinuteCombo" Style="{StaticResource ComboField}" Width="70"/>
                        <Button x:Name="BtnApplyTime" Content="✓" Style="{StaticResource IconButton}"
                                Margin="10,0,0,0" Click="BtnApplyTime_Click"/>
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>
    </ScrollViewer>
</Window>