<!-- UA: Точка входу WPF — без головного вікна, тільки трей
     EN: WPF entry point — no main window, tray only -->
<Application x:Class="EMP.UAHelper.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- UA: Спільні стилі, доступні з будь-якого вікна без дублювання
                     EN: Shared styles available from any window without duplication -->
                <ResourceDictionary Source="Styles/DarkComboBox.xaml"/>
                <ResourceDictionary Source="Styles/DarkCalendar.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>